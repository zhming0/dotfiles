{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "formatter": {
    "cljfmt": {
      "disabled": true
    },
    "cljstyle": {
      "command": ["cljstyle", "fix", "$FILE"],
      "extensions": [".clj", ".cljs", ".cljc", ".edn"]
    }
  }
}
